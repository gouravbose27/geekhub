<%- include('partials/header') %>
<h1>Forgot password</h1>
<% if (message) { %><div class="alert success"><%= message %></div><% } %>
<form method="post" action="/forgot-password" class="card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>Username or email
    <input name="login" value="<%= form.login || '' %>" required autofocus autocomplete="username">
  </label>
  <button type="submit">Create reset link</button>
</form>
<% if (resetUrl) { %>
  <p>Use this one-time reset link:</p>
  <p><a href="<%= resetUrl %>"><%= resetUrl %></a></p>
<% } %>
<p>Remembered your password? <a href="/login">Sign in</a></p>
<%- include('partials/footer') %>
